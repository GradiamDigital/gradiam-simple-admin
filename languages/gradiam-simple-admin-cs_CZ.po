#. Description of the plugin
#: gradiam-simple-admin.php
msgid "Simplified administration for clients: \"Site manager\" role, a short menu, a start screen with tiles, no update notices or technical screens."
msgstr "Zjednodušená administrace pro klienty: role „Správce webu“, krátké menu, úvodní obrazovka s dlaždicemi, bez upozornění na aktualizace a technických obrazovek."

#. Author of the plugin
#: gradiam-simple-admin.php
msgid "GradiamDigital"
msgstr "GradiamDigital"

