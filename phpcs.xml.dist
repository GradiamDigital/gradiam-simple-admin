<?xml version="1.0"?>
<ruleset name="Gradiam Simple Admin">
	<description>WordPress Coding Standards for the plugin. Run: composer lint / composer fix</description>

	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/public/*</exclude-pattern>
	<exclude-pattern>/admin/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="minimum_supported_wp_version" value="6.5"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress">
		<!-- Class file names follow the plugin boilerplate pattern (class-gradiam-simple-admin-*.php). -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="gradiam-simple-admin"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="gradiam_simple_admin"/>
				<element value="Gradiam_Simple_Admin"/>
				<element value="GRADIAM_SIMPLE_ADMIN"/>
			</property>
		</properties>
	</rule>
</ruleset>
