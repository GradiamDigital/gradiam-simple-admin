root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{scss,css,json,yml,yaml}]
indent_style = space
indent_size = 2

[{composer.json,acf-json/*.json}]
indent_size = 4

[theme.json]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
